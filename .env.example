# ===== RIGRX environment variables =====
# Copy this file to .env for local dev. On Replit, add these in the Secrets tool instead.

# PostgreSQL connection string. Replit's PostgreSQL tool provides this automatically as DATABASE_URL.
DATABASE_URL=postgres://rigrx:rigrx@localhost:5432/rigrx

# Long random string used to sign session tokens. Change this!
SESSION_SECRET=change-me-to-a-long-random-string

# Public URL of the app (used in notification links)
BASE_URL=http://localhost:3000

# The phone number that gets ADMIN access when it signs in (your phone).
ADMIN_PHONE=+16615550100

# --- Stripe (leave blank to run in simulation mode: lead purchases succeed without charging) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# --- Twilio (leave blank to run in simulation mode: SMS are logged to the console instead of sent) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Port (Replit sets this automatically)
PORT=3000
